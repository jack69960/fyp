# Optional. Copy this file to ".env" and fill in real values if you want the
# app to read a live Neo4j instance. Without a reachable database the app
# automatically uses the bundled snapshot in data/graph_export.json.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Uncomment to ignore the database and always read the bundled snapshot.
# FYP_FORCE_JSON=1
